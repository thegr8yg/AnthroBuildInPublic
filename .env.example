# Copy this file to .env.local and fill in real values.
# The Notion board feeds the /api/tasks route handler.

# 1. Create an internal integration at https://www.notion.so/my-integrations
#    and copy the "Internal Integration Secret" here.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Share the Notion database with the integration, then paste the database id
#    (the 32-char segment before ?v= in the Notion URL).
NOTION_DATABASE_ID=00000000000000000000000000000000

# Expected database schema (property names are case-insensitive):
#   - Name (title)      — task title
#   - Status (select or status) — one of:
#       Side projects / Parking / Backlog  → "side" column
#       To do / On deck / Queued           → "todo" column
#       Urgent / On fire / Blocked         → "urgent" column
#       In progress / Cooking / Doing      → "progress" column
#       Complete / Done / Shipped          → "complete" column
#   - Owner (people)    — optional; first person's name is shown
